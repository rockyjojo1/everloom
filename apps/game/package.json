{
  "name": "@everloom/game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:pwa": "pnpm run build && playwright test tests/pwa-offline.spec.ts --config=playwright.pwa.config.ts",
    "preview": "vite preview",
    "verify:gate0": "node scripts/verify-gate0.mjs",
    "validate:visual-production": "node ../../art-direction/scripts/validate-visual-production-manifest.mjs",
    "test:visual-production": "node ../../art-direction/scripts/validate-visual-production-manifest.test.mjs",
    "verify:visual-foundation": "node scripts/verify-visual-foundation.mjs"
  },
  "dependencies": {
    "@everloom/assets": "workspace:*",
    "@everloom/content": "workspace:*",
    "@everloom/core": "workspace:*",
    "@supabase/supabase-js": "^2.47.2",
    "idb": "^7.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.155.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.155.1",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.2.4"
  }
}
